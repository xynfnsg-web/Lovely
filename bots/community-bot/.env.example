# Store DISCORD_TOKEN in Replit Secrets (or your local .env file).
DISCORD_TOKEN=

# Default prefix for servers that have not changed it with fprefix.
BOT_PREFIX=f

# Optional comma-separated Discord role IDs that are treated as staff.
STAFF_ROLE_IDS=

# Replit provides this for the project database. For local use, supply a PostgreSQL URL.
DATABASE_URL=

# Optional managed AI model. Replit provisions the AI endpoint and credential;
# do not copy those credentials into source files or this example.
AI_MODEL=gpt-5.4-mini
